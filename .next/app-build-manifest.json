      "static/chunks/app/(store)/product/[slug]/loading.js"
    ],
    "/(store)/checkout/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(store)/checkout/page.js"
    ],
    "/(store)/checkout/success/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(store)/checkout/success/page.js"
    ],
    "/(store)/account/orders/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(store)/account/orders/page.js"
    ]
  }
